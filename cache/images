#!/bin/sh
# see README "Caching around your own run"
set -eu
images=$HOME/.cache/bencher/images
case "${1:-}" in
  prefix)
    mkdir -p "$images"
    bench=$(printf '%s' "$2" | sha256sum | cut -c1-16)
    echo "prefix=bencher-images-$RUNNER_OS-$bench-" >> "$GITHUB_OUTPUT"
    echo "key=bencher-images-$RUNNER_OS-$bench-$(cat /proc/sys/kernel/random/uuid)" >> "$GITHUB_OUTPUT"
    ;;
  mark)
    mkdir -p "$images"
    ls "$images" > "$RUNNER_TEMP/$2.restored"
    if [ -n "$3" ]; then
      echo "::warning title=cached runner images::restored $3: a hit races what that image was provisioned with"
      echo "hit=true" >> "$GITHUB_OUTPUT"
    else
      echo "hit=false" >> "$GITHUB_OUTPUT"
    fi
    echo "matched=$3" >> "$GITHUB_OUTPUT"
    ;;
  prune)
    key=$(jq -r '.cache.key // ""' "$2" 2>/dev/null || true)
    base=$(jq -r '.cache.base.key // ""' "$2" 2>/dev/null || true)
    mkdir -p "$images"
    cd "$images"
    if [ -n "$key" ]; then
      find . -maxdepth 1 -type f ! -name "$key.tar" ! -name "$key.sha256" \
        ! -name "${base:-$key}.tar" ! -name "${base:-$key}.sha256" -delete
    fi
    if [ -f "$RUNNER_TEMP/$3.restored" ] && ls | cmp -s - "$RUNNER_TEMP/$3.restored"; then
      echo "changed=false" >> "$GITHUB_OUTPUT"
    else
      echo "changed=true" >> "$GITHUB_OUTPUT"
    fi
    ;;
  *)
    echo "usage: images prefix <bench> | mark <key> <matched> | prune <report> <key>" >&2
    exit 2
    ;;
esac
